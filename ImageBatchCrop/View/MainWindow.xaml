<mah:MetroWindow
    x:Class="ImageBatchCrop.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:ImageBatchCrop"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rp="clr-namespace:Reactive.Bindings.Interactivity;assembly=ReactiveProperty.WPF"
    xmlns:vm="clr-namespace:ImageBatchCrop.ViewModel"
    Title="Image Batch Crop"
    Width="1150"
    Height="700"
    mc:Ignorable="d">

    <mah:MetroWindow.Resources>

        <local:FileNameConverter x:Key="FileNameConverter" />

        <Style x:Key="ResizeThumb" TargetType="Thumb">

            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="Red" />
            <Setter Property="BorderThickness" Value="1" />

        </Style>

    </mah:MetroWindow.Resources>

    <mah:MetroWindow.DataContext>
        <vm:MainViewModel />
    </mah:MetroWindow.DataContext>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <!--  上部：実行ボタン  -->
            <RowDefinition Height="45" />

            <!--  上部：実行ボタン  -->
            <RowDefinition Height="50" />

            <!--  下部：画像＋ファイル一覧  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--  =========================  -->
        <!--  上：実行ボタン  -->
        <!--  =========================  -->

        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <Button
                Width="100"
                Height="30"
                Command="{Binding ExecuteCropCommand}"
                Content="実行" />

        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel
                Margin="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <!--  子要素  -->
                <!--  マウスホイール：縦スクロール  -->
                <StackPanel
                    Margin="0,0,50,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <TextBlock
                        Margin="2,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="🖱️" />

                    <TextBlock VerticalAlignment="Center" Text="ホイール回転：縦スクロール" />
                </StackPanel>

                <!--  Ctrl + マウスホイール  -->
                <StackPanel
                    Margin="0,0,50,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Padding="8,4"
                        Background="#EEEEEE"
                        BorderBrush="#AAAAAA"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#222222"
                            Text="Ctrl" />
                    </Border>

                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                        Text="  +  " />

                    <TextBlock
                        Margin="2,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="🖱️" />

                    <TextBlock VerticalAlignment="Center" Text="ホイール回転：拡大・縮小" />
                </StackPanel>


                <!--  Alt + マウスホイール  -->
                <StackPanel
                    Margin="0,4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Padding="8,4"
                        Background="#EEEEEE"
                        BorderBrush="#AAAAAA"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#222222"
                            Text="Alt" />
                    </Border>

                    <TextBlock VerticalAlignment="Center" Text="  +  " />

                    <TextBlock
                        Margin="2,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="🖱️" />

                    <TextBlock VerticalAlignment="Center" Text="ホイール回転：横スクロール" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  =========================  -->
        <!--  下：メイン領域  -->
        <!--  =========================  -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <!--  画像表示：固定  -->
                <ColumnDefinition Width="900" />

                <!--  区切り  -->
                <ColumnDefinition Width="10" />

                <!--  ファイル一覧  -->
                <ColumnDefinition Width="200" />

            </Grid.ColumnDefinitions>


            <!--  =========================  -->
            <!--  左：画像表示  -->
            <!--  =========================  -->

            <Border
                Grid.Column="0"
                Width="900"
                Height="500"
                Background="#F5F5F5"
                BorderBrush="Gray"
                BorderThickness="1"
                ClipToBounds="True"
                PreviewMouseWheel="ImageBorder_PreviewMouseWheel">

                <!--  ScrollViewer がホイールを処理する前に修飾キー付き操作を処理する  -->
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseWheel">
                        <rp:EventToReactiveCommand Command="{Binding ZoomImageCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <!--  拡大した画像をスクロールできるようにする  -->
                <ScrollViewer
                    x:Name="ImageScrollViewer"
                    Width="850"
                    CanContentScroll="False"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">

                    <Grid
                        Width="850"
                        Height="450"
                        RenderTransformOrigin="0,0">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Zoom.Value}" ScaleY="{Binding Zoom.Value}" />
                        </Grid.LayoutTransform>

                        <!--  画像  -->
                        <Image
                            x:Name="MainImage"
                            Width="800"
                            Height="450"
                            Margin="-40,0,40,0"
                            Source="{Binding CurrentImage.Value}"
                            Stretch="Fill" />

                        <!--  矩形操作用  -->
                        <Canvas
                            x:Name="CropCanvas"
                            Width="800"
                            Height="450"
                            Margin="-40,0,40,0"
                            Background="Transparent">

                            <!--  選択範囲  -->
                            <Border
                                x:Name="CropBorder"
                                Canvas.Left="{Binding CropLeft.Value}"
                                Canvas.Top="{Binding CropTop.Value}"
                                Width="{Binding CropWidth.Value}"
                                Height="{Binding CropHeight.Value}"
                                Background="#20FF0000"
                                BorderBrush="Red"
                                BorderThickness="2">

                                <i:Interaction.Triggers>

                                    <i:EventTrigger EventName="MouseLeftButtonDown">
                                        <rp:EventToReactiveCommand Command="{Binding CropMouseLeftButtonDownCommand}" />
                                    </i:EventTrigger>

                                    <i:EventTrigger EventName="MouseMove">
                                        <rp:EventToReactiveCommand Command="{Binding CropMouseMoveCommand}" />
                                    </i:EventTrigger>

                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <rp:EventToReactiveCommand Command="{Binding CropMouseLeftButtonUpCommand}" />
                                    </i:EventTrigger>

                                </i:Interaction.Triggers>

                                <Grid>

                                    <!--  NW  -->
                                    <Thumb
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ResizeThumb}"
                                        Tag="NW">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="DragDelta">
                                                <rp:EventToReactiveCommand Command="{Binding ResizeCropCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Thumb>

                                    <!--  N  -->
                                    <Thumb
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ResizeThumb}"
                                        Tag="N">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="DragDelta">
                                                <rp:EventToReactiveCommand Command="{Binding ResizeCropCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Thumb>

                                    <!--  NE  -->
                                    <Thumb
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource ResizeThumb}"
                                        Tag="NE">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="DragDelta">
                                                <rp:EventToReactiveCommand Command="{Binding ResizeCropCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Thumb>

                                    <!--  W  -->
                                    <Thumb
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ResizeThumb}"
                                        Tag="W">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="DragDelta">
                                                <rp:EventToReactiveCommand Command="{Binding ResizeCropCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Thumb>

                                    <!--  E  -->
                                    <Thumb
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ResizeThumb}"
                                        Tag="E">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="DragDelta">
                                                <rp:EventToReactiveCommand Command="{Binding ResizeCropCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Thumb>

                                    <!--  SW  -->
                                    <Thumb
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource ResizeThumb}"
                                        Tag="SW">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="DragDelta">
                                                <rp:EventToReactiveCommand Command="{Binding ResizeCropCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Thumb>

                                    <!--  S  -->
                                    <Thumb
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource ResizeThumb}"
                                        Tag="S">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="DragDelta">
                                                <rp:EventToReactiveCommand Command="{Binding ResizeCropCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Thumb>

                                    <!--  SE  -->
                                    <Thumb
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource ResizeThumb}"
                                        Tag="SE">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="DragDelta">
                                                <rp:EventToReactiveCommand Command="{Binding ResizeCropCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Thumb>

                                </Grid>

                            </Border>

                        </Canvas>

                    </Grid>
                </ScrollViewer>

            </Border>


            <!--  =========================  -->
            <!--  右：ファイル一覧  -->
            <!--  =========================  -->

            <Border
                Grid.Column="2"
                AllowDrop="True"
                BorderBrush="Gray"
                BorderThickness="1">

                <i:Interaction.Triggers>

                    <i:EventTrigger EventName="DragOver">
                        <rp:EventToReactiveCommand Command="{Binding FileDropAreaDragOverCommand}" />
                    </i:EventTrigger>

                    <i:EventTrigger EventName="Drop">
                        <rp:EventToReactiveCommand Command="{Binding FileDropAreaDropCommand}" />
                    </i:EventTrigger>

                </i:Interaction.Triggers>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="10,8"
                        FontWeight="Bold"
                        Text="対象ファイル" />

                    <ListBox
                        Grid.Row="1"
                        Margin="5"
                        ItemsSource="{Binding ImageFiles}"
                        SelectedItem="{Binding SelectedImage}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <TextBlock
                                    Margin="5,3"
                                    Text="{Binding Converter={StaticResource FileNameConverter}}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding}" />

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</mah:MetroWindow>